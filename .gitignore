# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Logs / temp
*.log
*.pid
*.tmp
*.bak

# Local install
install.log

# ==== OpenMAIC (Next.js) — paths the project .gitignore does not cover ====
# Per-project ignores live in OpenMAIC/.gitignore and are still respected
# (git walks every .gitignore under the worktree). The entries below are
# either missed by the project's ignore OR generated by build artifacts
# that may land outside the project root when run from a parent shell.

# pnpm / node
OpenMAIC/.pnpm-store/
OpenMAIC/node_modules/

# Next.js build + cache
OpenMAIC/.next/
OpenMAIC/out/
OpenMAIC/coverage/
OpenMAIC/turbo.json.lock

# Local env files
OpenMAIC/.env
OpenMAIC/.env.local
OpenMAIC/.env.*.local
OpenMAIC/.env.production

# Model + cache (CRITICAL: ms-cache is 5GB+; will blow up the repo)
OpenMAIC/ms-cache/
OpenMAIC/.trae-models/

# TTS audio cache (server-side generated; not source)
OpenMAIC/public/audio-cache/

# Server-side runtime data
OpenMAIC/data/classrooms/
OpenMAIC/data/classroom-jobs/

# Trae IDE working directory (KEEP .trae-cn/specs — spec docs go in git)
# but ignore transient / cached state
OpenMAIC/.trae-cn/cache/
OpenMAIC/.trae-cn/logs/

# ==== VoxCPM (Python TTS) — none of these were covered before ====
# Project never had its own .gitignore; until we add one, guard here.
VoxCPM/.venv/
VoxCPM/venv/
VoxCPM/__pycache__/
VoxCPM/*.pyc
VoxCPM/*.pyo
VoxCPM/.pytest_cache/
VoxCPM/.ruff_cache/
VoxCPM/.mypy_cache/
VoxCPM/models/                  # local model snapshots (5GB+)
VoxCPM/server.log
VoxCPM/watchdog.log
VoxCPM/server.pid
VoxCPM/test_*.wav
VoxCPM/vol_test_*.wav

# ==== Secrets (NEVER commit) ====
.git-credentials.tmp
.git-credentials
.push-state/
